# ─── ElectionGorilla Environment Variables (Section 10) ───────────────────────

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/electiongorilla

# Redis connection string for BullMQ job queues
REDIS_URL=redis://localhost:6379

# Anthropic Claude API key — powers all AI agents
ANTHROPIC_API_KEY=sk-ant-...

# Federal Election Commission data API
FEC_API_KEY=DEMO_KEY

# Ballotpedia — candidate and race metadata
BALLOTPEDIA_API_KEY=

# NewsAPI — news monitoring for Monitor Agent
NEWS_API_KEY=

# AWS S3 — audio file storage for recorded scripts
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=electiongorilla-audio

# NextAuth — dashboard authentication
NEXTAUTH_SECRET=change-me-to-a-random-string
NEXTAUTH_URL=http://localhost:3000

# Operator notification webhook (Slack or SMS) for BREAKING alerts
OPERATOR_NOTIFICATION_WEBHOOK=

# $GRLA token contract address (stub for now)
GRLA_CONTRACT_ADDRESS=
